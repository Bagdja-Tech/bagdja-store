# Centralized login frontend
NEXT_PUBLIC_LOGIN_URL=https://login.bagdja.com

# Auth API (used for /auth/me and client token)
NEXT_PUBLIC_AUTH_API=https://auth.bagdja.com

# Piece service API (optional; defaults to NEXT_PUBLIC_AUTH_API)
# NEXT_PUBLIC_PIECE_API=https://auth.bagdja.com

# Client app credentials (required to fetch balance via Piece API)
NEXT_PUBLIC_CLIENT_APP_ID=bagdja-store
NEXT_PUBLIC_CLIENT_APP_SECRET=__SET_ME__

# ============================================
# Bagdja Store Environment Variables
# ============================================
# Copy this file to .env.local and fill in the actual values
# Never commit .env.local to version control

# ============================================
# Base URL Configuration
# ============================================
# Base URL for the store application
# Used for redirects and metadata
# Examples:
#   Development: http://localhost:3002
#   Production: https://store.bagdja.com
NEXT_PUBLIC_BASE_URL=http://localhost:3002

# ============================================
# Authentication Configuration
# ============================================
# Centralized login frontend URL
# Users will be redirected here for authentication
NEXT_PUBLIC_LOGIN_URL=https://login.bagdja.com

# Auth API base URL
# Used for /auth/me, user profile, and authentication endpoints
# Examples:
#   Development: http://localhost:3001
#   Production: https://auth.bagdja.com
NEXT_PUBLIC_AUTH_API=https://auth.bagdja.com

# ============================================
# Piece Service API (Optional)
# ============================================
# Piece service API base URL
# If not set, will default to NEXT_PUBLIC_AUTH_API
# Only set this if your piece service runs on a different URL
# NEXT_PUBLIC_PIECE_API=https://auth.bagdja.com

# ============================================
# Client App Credentials
# ============================================
# Client app ID for bagdja-store
# Used to identify this application to the auth service
NEXT_PUBLIC_CLIENT_APP_ID=bagdja-store

# Client app secret (REQUIRED for Piece API calls)
# Used to fetch client token for API authentication
# IMPORTANT: Keep this secret secure and never expose it in client-side code
# Get this value from your auth service administrator
NEXT_PUBLIC_CLIENT_APP_SECRET=__SET_ME__

# ============================================
# Google Analytics (Optional)
# ============================================
# Google Analytics 4 Measurement ID
# Get your Measurement ID from https://analytics.google.com/
# Format: G-XXXXXXXXXX
# Leave empty if you don't want to use Google Analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
